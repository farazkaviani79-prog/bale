# --- دیتابیس: دو نقش جدا (ساخت نقش‌ها: infra/postgres-init.sql) ---
DATABASE_URL="postgresql://botshop_app:CHANGE_ME_app@localhost:5432/botshop?schema=public"
SYSTEM_DATABASE_URL="postgresql://botshop_system:CHANGE_ME_system@localhost:5432/botshop?schema=public"
# فقط برای اجرای Migration (مالک دیتابیس)
MIGRATE_DATABASE_URL="postgresql://botshop:CHANGE_ME_owner@localhost:5432/botshop?schema=public"
REDIS_URL="redis://localhost:6379"

API_PORT=4000
PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000"
MINIAPP_BASE_URL="http://localhost:3000/miniapp"

# حداقل ۳۲ کاراکتر تصادفی:   openssl rand -base64 48
JWT_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_48"
# ۳۲ بایت base64:           openssl rand -base64 32
APP_ENCRYPTION_KEY="CHANGE_ME_generate_with_openssl_rand_base64_32"

# mock | http  (http فقط پس از تأیید مستندات رسمی بله)
BALE_MODE=mock
BALE_API_BASE_URL="https://tapi.bale.ai"
# فقط توکن آزمایشی پذیرفته می‌شود (WALLET-TEST-...)؛ توکن واقعی تا روشن‌شدن ADR 0001 رد می‌شود
BALE_PROVIDER_TOKEN=""
INITDATA_VERIFIED=false
RESERVATION_TTL_MINUTES=15

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# پنل وب: فقط توسعه — اجازه initData از آدرس برای تست Mock (در Production باید false باشد)
NEXT_PUBLIC_MINIAPP_DEV=false
API_INTERNAL_URL=

# آپلود تصویر کالا (دیسک محلی؛ روی سرور یک Volume پایدار بگذارید)
UPLOAD_DIR=./uploads
# پشتیبان‌گیری (scripts/backup.sh)
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_GPG_RECIPIENT=
